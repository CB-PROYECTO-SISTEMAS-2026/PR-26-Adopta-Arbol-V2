# ============================================================
# ADOPTA ÁRBOL V2 - Variables de Entorno
# ============================================================
# Copia este archivo como .env y completa los valores:
#   cp .env.example .env
# ============================================================

# ── Servidor ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Base de datos ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=adopta_arbol

# ── Seguridad ─────────────────────────────────────────────────
# Usa al menos 32 caracteres aleatorios. Ejemplo: openssl rand -hex 32
JWT_SECRET=CAMBIA_ESTO_POR_MINIMO_32_CARACTERES_ALEATORIOS
SESSION_SECRET=CAMBIA_ESTO_POR_MINIMO_32_CARACTERES_ALEATORIOS

# ── Cliente (Frontend) ────────────────────────────────────────
VITE_API_URL=http://localhost:3000
